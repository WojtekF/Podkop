<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test-only project (ADR 0010): the Testcontainers PostgreSQL fixture, the Respawn reset,
         and the WebApplicationFactory connection-string plumbing that slice test projects
         consume. Mvc.Testing carries the factory type the plumbing extends;
         xunit.extensibility.core carries the fixture lifecycle contract without dragging the
         assertion library into a non-test assembly. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <PackageReference Include="Respawn" Version="7.0.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
  </ItemGroup>

</Project>
