<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The persistence specs (issue #68) build the slice's context from a host builder and from
         the design-time factory; the model-shape specs open no connection, while the behavior
         specs run against real PostgreSQL through the shared fixture — Docker is a hard
         requirement for this suite. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Podkop.Server\Podkop.Server.csproj" />
    <!-- The behavior specs run against real PostgreSQL with BOTH slices' schemas up on the
         shared fixture (issue #68) — Docker is a hard requirement for this suite. -->
    <ProjectReference Include="..\..\..\Shared\Podkop.Shared.Testing\Podkop.Shared.Testing.csproj" />
    <ProjectReference Include="..\Podkop.FindingComments.Domain\Podkop.FindingComments.Domain.csproj" />
    <ProjectReference Include="..\Podkop.FindingComments.Infrastructure\Podkop.FindingComments.Infrastructure.csproj" />
    <!-- The HTTP seam runs through the composition root, so seeding a discussion also means
         seeding the finding it hangs off — hence the references into the Findings slice.
         Production code never crosses slices like this; tests at the composition root may. -->
    <ProjectReference Include="..\..\Findings\Podkop.Findings.Domain\Podkop.Findings.Domain.csproj" />
    <ProjectReference Include="..\..\Findings\Podkop.Findings.Infrastructure\Podkop.Findings.Infrastructure.csproj" />
  </ItemGroup>

</Project>
