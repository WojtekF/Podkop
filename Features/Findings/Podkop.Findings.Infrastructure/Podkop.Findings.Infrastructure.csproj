<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Podkop.Findings.Application\Podkop.Findings.Application.csproj" />
    <ProjectReference Include="..\..\..\Shared\Podkop.Shared.Infrastructure\Podkop.Shared.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR 0010: the slice owns its context, its migrations, and its design-time factory.
         The Design package is a build-time dependency of the EF tooling, so it does not flow
         on to the hosts that reference this project. -->
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.6" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- The outbox specs (issue #77) must build this slice's context with the interceptor
         attached, and must configure it through the same UseFindingsPostgres every other caller
         uses — a spec spelling the provider facts itself would prove nothing about the context
         the running system builds. Test access rather than a wider public surface. -->
    <InternalsVisibleTo Include="Podkop.Findings.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
